datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  idpConfig TenantIdpConfig?
  users     User[]

  @@map("tenants")
}

model TenantIdpConfig {
  id                String  @id @default(uuid())
  tenantId          String  @unique @map("tenant_id")
  ssoEnabled        Boolean @default(false) @map("sso_enabled")
  idpAlias          String? @map("idp_alias")
  mfaRequired       Boolean @default(false) @map("mfa_required")
  localLoginEnabled Boolean @default(true) @map("local_login_enabled")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_idp_config")
}

model User {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  externalObjectId String    @map("external_object_id")
  email            String
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  auditLogs LoginAuditLog[]

  @@unique([tenantId, externalObjectId])
  @@map("users")
}

model LoginAuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  eventType String   @map("event_type")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("login_audit_log")
}
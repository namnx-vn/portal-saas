datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  idpConfig       TenantIdpConfig?
  users           User[]
  departments     Department[]
  departmentRoles DepartmentRole[]
  personalDailyMetrics PersonalDailyMetric[]

  @@map("tenants")
}

model TenantIdpConfig {
  id                String  @id @default(uuid())
  tenantId          String  @unique @map("tenant_id")
  ssoEnabled        Boolean @default(false) @map("sso_enabled")
  idpAlias          String? @map("idp_alias")
  mfaRequired       Boolean @default(false) @map("mfa_required")
  localLoginEnabled Boolean @default(true) @map("local_login_enabled")
  authMode          String  @default("entra") @map("auth_mode") // "entra" | "native"

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_idp_config")
}

model User {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  externalObjectId String?   @map("external_object_id") // null cho user native
  email            String
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  role             String    @default("member") @map("role") // "admin" | "member"
  passwordHash     String?   @map("password_hash") // null tới khi user tự đặt
  inviteTokenHash  String?   @unique @map("invite_token_hash")
  inviteExpiresAt  DateTime? @map("invite_expires_at")
  mfaOtpHash       String?   @map("mfa_otp_hash") // OTP cho native login khi mfa_required
  mfaOtpExpiresAt  DateTime? @map("mfa_otp_expires_at")
  departmentRoleId String?   @map("department_role_id")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  auditLogs      LoginAuditLog[]
  departmentRole DepartmentRole? @relation(fields: [departmentRoleId], references: [id])
  personalDailyMetrics PersonalDailyMetric[]

  @@unique([tenantId, externalObjectId])
  @@unique([tenantId, email]) // lookup native login + siết BR-05
  @@map("users")
}

model LoginAuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  eventType String   @map("event_type")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("login_audit_log")
}

model PersonalDailyMetric {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  tenantId         String   @map("tenant_id")
  recordedOn       DateTime @db.Date @map("recorded_on")
  focusMinutes     Int      @default(0) @map("focus_minutes")
  meetingMinutes   Int      @default(0) @map("meeting_minutes")
  learningMinutes  Int      @default(0) @map("learning_minutes")
  personalMinutes  Int      @default(0) @map("personal_minutes")
  tasksPlanned     Int      @default(0) @map("tasks_planned")
  tasksCompleted   Int      @default(0) @map("tasks_completed")
  learningSessions Int      @default(0) @map("learning_sessions")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, recordedOn])
  @@index([tenantId, userId, recordedOn])
  @@map("personal_daily_metrics")
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  roles  DepartmentRole[]

  @@unique([tenantId, name])
  @@map("departments")
}

model DepartmentRole {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  departmentId String   @map("department_id")
  name         String
  permissions  String[] @default([]) @map("permissions")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  users      User[]

  @@unique([tenantId, departmentId, name])
  @@map("department_roles")
}
